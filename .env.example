# PostgreSQL connection string. Use a persistent managed PostgreSQL database in production.
DATABASE_URL="postgresql://postgres:password@localhost:5432/runfourcode"
# Optional schema-owner URL used only by `npm run db:migrate` in production.
MIGRATION_DATABASE_URL=""

# Firebase Authentication project used for client sign-in. Admin access does not use Firebase.
FIREBASE_PROJECT_ID="runfourcode"

# Admin credentials are checked by the Node server. Set ADMIN_PASSWORD in a secret manager.
ADMIN_EMAIL="ran4code@gmail.com"
ADMIN_PASSWORD=""

# Generate a random secret of at least 32 characters; invalidates all admin sessions when rotated.
ADMIN_SESSION_SECRET=""

# Optional locally when not using Google Application Default Credentials.
# Never commit service-account credentials.
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# Optional AI debugger API key.
GEMINI_API_KEY=""

# Set to true behind a trusted reverse proxy such as Cloud Run.
TRUST_PROXY="false"
